                                                                                          owl:onProperty <http://www.semanticweb.org/nikos/ontologies/2025/2/semanticApp/isAuthorOf> ;
                                                                                          owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                                          owl:onClass <http://www.semanticweb.org/nikos/ontologies/2025/2/semanticApp/Publication>
                                                                                        ] ,
                                                                                        [ rdf:type owl:Restriction ;
                                                                                          owl:onProperty <http://www.semanticweb.org/nikos/ontologies/2025/2/semanticApp/isCorrespondingUser> ;
                                                                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                          owl:onClass <http://www.semanticweb.org/nikos/ontologies/2025/2/semanticApp/User>
                                                                                        ] .


###  http://www.semanticweb.org/nikos/ontologies/2025/2/semanticApp/Keyword
