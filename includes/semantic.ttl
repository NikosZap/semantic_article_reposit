                                                                             owl:inverseOf <http://www.semanticweb.org/nikos/ontologies/2025/2/semanticApp#isFullTextOF> ;
                                                                             rdfs:domain <http://www.semanticweb.org/nikos/ontologies/2025/2/semanticApp/Publication> ;
